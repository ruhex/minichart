yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Local env and secrets ────────────────────────────────────────────────────
# Nothing here reads env vars today; the rules exist so that adding a publish
# token or an API key later cannot silently reach a commit.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.npmrc
.yarnrc
secrets.json
credentials.json

